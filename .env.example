GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLSdTvWD8TjviN_sAG6LXT5N6GBnrp14Sjw3Bf0lDx3tANDEPBA/viewform
# Live V26 beta registration form (wired in config.js → googleFormUrl).
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/1LuBd1FhSykQhvDMChNomsCimscPAbYed0y5DaR19ftc/edit
# Live linked response Sheet "V26 Inference — Beta responses" (config.js → googleSheetUrl).
# Optional prefill entry-IDs (Form → ⋮ → Get pre-filled link):
# GOOGLE_FORM_PREFILL_UTM_SOURCE=entry.XXXXXXXXX
ANALYTICS_PROVIDER=local
# local | plausible | posthog | none
CONTACT_EMAIL=hello@v26-inference.com
